{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "upkaran",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SIGNAL_DO",
        "class_name": "SignalRoomDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SignalRoomDurableObject"
      ]
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
