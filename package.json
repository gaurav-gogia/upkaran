{
    "name": "upkaran",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "node ./scripts/generate-public-assets.mjs",
        "dev": "vite",
        "prebuild": "node ./scripts/generate-public-assets.mjs",
        "build": "vite build",
        "preview": "npm run build && wrangler dev",
        "build:wasm": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-wasm.ps1",
        "reliability:sample": "node ./scripts/reliability-sample-run.mjs",
        "reliability:full": "npm run reliability:sample && npm run reliability:baseline",
        "reliability:baseline": "node ./scripts/reliability-baseline.mjs",
        "deploy": "npm run build && wrangler deploy"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.35.0",
        "@sveltejs/vite-plugin-svelte": "*",
        "svelte": "*",
        "vite": "*",
        "wrangler": "^4.87.0"
    },
    "dependencies": {
        "djvujs-dist": "^0.5.4",
        "fflate": "*",
        "heic2any": "*",
        "highlight.js": "*",
        "html2canvas": "*",
        "js-yaml": "*",
        "jsqr": "*",
        "katex": "*",
        "marked": "*",
        "mermaid": "*",
        "pdf-lib": "*",
        "pdfjs-dist": "*",
        "plantuml-encoder": "*",
        "qrcode": "*",
        "quill": "^2.0.3"
    }
}
